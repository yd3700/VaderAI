index 00000000..2f090fa6
--- /dev/null
+++ b/crates/windows/src/tree/menu_command.rs
@@ -0,0 +1,77 @@
+//! WinForms menu items as commands rather than screen positions.
+//!
+//! A ToolStrip menu item stays invocable while its drop-down is closed, and
+//! its `IsOffscreen` is no visibility evidence at all: with a drop-down open
+//! and painting its items 35 of 38 read offscreen, while 18 of 210 items of
+//! closed sibling menus read on-screen; `Invoke` on a closed-menu item ran its
+//! command (measured live on a WinForms menu host, 2026-11-16). The live read
+//! keeps reporting what the provider says. This answers only the question
+//! core's visibility gate asks before a headless semantic click.
+
+use agent_desktop_core::Deadline;
+
+use super::hit_test::corroborate::{first_native_hwnd, root_of_hwnd};
+use crate::tree::automation::automation_client;
+use crate::tree::element::UIAElement;
+
+const WINFORMS_CLASS_PREFIX: &str = "WindowsForms10.";
+
+/// Whether the element is a WinForms menu item whose host control and
+/// top-level window both exist, are shown, and are not minimized. Every failed
+/// read answers no; the window state is asked last so it is the freshest fact.
+pub(crate) fn is_closed_menu_command(element: &UIAElement, deadline: Deadline) -> bool {
+    use uiautomation::types::ControlType;
+    if !matches!(element.0.get_control_type(), Ok(ControlType::MenuItem)) {
+        return false;
+    }
+    let Some(walker) = automation_client()
+        .ok()
+        .and_then(|client| client.get_raw_view_walker().ok())
+    else {
+        return false;
+    };
+    let Ok(Some(host)) = first_native_hwnd(element, &walker, deadline) else {
+        return false;
+    };
+    let Some(root) = root_of_hwnd(host) else {
+        return false;
+    };
+    is_winforms_class(&class_name(host)) && !deadline.is_expired() && shown(host, root)
+}
+
+/// Both windows are live and visible (a child's visibility includes every
+/// ancestor's) and the top-level one is not minimized.
+pub(crate) fn shown(host: isize, root: isize) -> bool {
+    use windows_sys::Win32::UI::WindowsAndMessaging::{IsIconic, IsWindow, IsWindowVisible};
+
+    let (host, root) = (host as *mut std::ffi::c_void, root as *mut std::ffi::c_void);
+    unsafe {
+        IsWindow(host) != 0
+            && IsWindow(root) != 0
+            && IsWindowVisible(host) != 0
+            && IsWindowVisible(root) != 0
+            && IsIconic(root) == 0
+    }
+}
+
+fn class_name(hwnd: isize) -> String {
+    use windows_sys::Win32::UI::WindowsAndMessaging::GetClassNameW;
+
+    let mut buffer = [0u16; 256];
+    let length = unsafe {
+        GetClassNameW(
+            hwnd as *mut std::ffi::c_void,
+            buffer.as_mut_ptr(),
+            buffer.len() as i32,
+        )
+    };
+    String::from_utf16_lossy(&buffer[..usize::try_from(length).unwrap_or(0)])
+}
+
+pub(crate) fn is_winforms_class(class: &str) -> bool {
+    class.starts_with(WINFORMS_CLASS_PREFIX)
+}
