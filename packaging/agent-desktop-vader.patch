+#[test]
+fn only_a_winforms_host_class_qualifies() {
+    assert!(is_winforms_class(
+        "WindowsForms10.Window.8.app.0.141b42a_r9_ad1"
+    ));
+    assert!(!is_winforms_class("#32768"));
+    assert!(!is_winforms_class("HwndWrapper[App;;x]"));
+    assert!(!is_winforms_class(""));
