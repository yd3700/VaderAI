+/// A menu item is a command, not a screen position: a headless semantic click
+/// never aims a pointer, so a provider's offscreen report on one does not
+/// refuse it when the adapter vouches for the platform shape. Hidden state,
+/// every other action, and every pointer-delivered click keep the gate.
+pub(super) fn visible_or_menu_command(
+    visibility: ActionabilityCheck,
+    evidence: &ActionabilityEvidence,
+    request: &ActionRequest,
+    delivered_without_pointer: bool,
+    hit_test: Option<(
+        &crate::adapter::NativeHandle,
+        &dyn crate::adapter::PlatformAdapter,
+    )>,
+    deadline: crate::Deadline,
+) -> Result<ActionabilityCheck, crate::AdapterError> {
+    let applies = delivered_without_pointer
+        && matches!(request.action, Action::Click)
+        && matches!(visibility.status, super::status::ActionabilityStatus::Fail)
+        && evidence.state.role == "menuitem"
+        && evidence.states_complete
+        && evidence.state.hidden != Some(true)
+        && !crate::tree::state::has_state(&evidence.state.states, crate::tree::state::HIDDEN);
+    match hit_test {
+        Some((handle, adapter))
+            if applies && adapter.is_closed_menu_command(handle, deadline)? =>
+        {
+            Ok(pass("visible"))
+        }
+        _ => Ok(visibility),
+    }
+}
