diff --git a/crates/windows/src/tree/properties/identity_scope.rs b/crates/windows/src/tree/properties/identity_scope.rs
new file mode 100644
index 00000000..7d4b007d
--- /dev/null
+++ b/crates/windows/src/tree/properties/identity_scope.rs
@@ -0,0 +1,188 @@
+//! VaderAI patch: identity that one element cannot report about itself, read
+//! with live hops to its raw-view ancestors. Every failed or unfinished read
+//! is `Unknown`, which makes the element's identifier unknown, so it can
+//! neither prove nor match a twin.
+
+use agent_desktop_core::Deadline;
+use uiautomation::types::ControlType;
+
+use super::element_properties::{ElementProperties, escape_id};
+use super::property_ids::TreeProperty;
+use super::property_outcome::{PropertyOutcome, PropertyValue};
+use crate::tree::element::UIAElement;
+
+/// Most names a menu path holds, own name included; menus nest a handful
+/// deep, so a longer chain is not a menu path. The walk and the live climb
+/// both stop here.
+pub(crate) const MAX_MENU_DEPTH: usize = 8;
+
+/// One live hop to the raw-view parent, read only for an identified Edit.
+/// Direct parent only; a wrapper that nests the box deeper is not seen.
+pub(super) fn parent_automation_id(element: &UIAElement) -> PropertyOutcome {
+    let read = || -> Option<String> {
+        let client = crate::tree::automation::automation_client().ok()?;
+        let walker = client.get_raw_view_walker().ok()?;
+        walker.get_parent(&element.0).ok()?.get_automation_id().ok()
+    };
+    match read() {
+        Some(id) if !id.trim().is_empty() => PropertyOutcome::Known(PropertyValue::Text(id)),
+        Some(_) => PropertyOutcome::Absent,
+        None => PropertyOutcome::Unknown,
+    }
+}
+
+/// The variable a caller sets to `1` to turn menu-path identity on for one
+/// engine process.
+pub(crate) const MENU_PATH_IDENTITY_ENV: &str = "AGENT_DESKTOP_MENU_PATH_IDENTITY";
+
+/// Whether this process identifies id-less menu items by their menu path.
+///
+/// Off unless the caller opts in. The path is built from the walk's child
+/// relation, and the single-element live read climbs the parent relation;
+/// the two agree on the WinForms menus measured (571 of 571 items on one
+/// host, and a second app) but not everywhere: an open WPF menu lists its
+/// items under the menu item while each item's parent is the popup's scroll
+/// viewer. Nothing cheap proves the agreement per item, so the caller that
+/// knows the window turns it on. One process reads the variable once, so the
+/// walk and the live read of one command can never disagree about it.
+pub(crate) fn menu_path_identity_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| opts_in(std::env::var(MENU_PATH_IDENTITY_ENV).ok().as_deref()))
+}
+
+/// Only the exact value `1` opts in.
+pub(crate) fn opts_in(value: Option<&str>) -> bool {
+    value == Some("1")
+}
+
+/// The name a menu path uses for an element: a read name, `""` for a
+/// provider that has none, `None` when the read failed.
+pub(crate) fn path_name(properties: &ElementProperties) -> Option<String> {
+    match properties.get(TreeProperty::Name) {
+        PropertyOutcome::Known(PropertyValue::Text(name)) => Some(name),
+        PropertyOutcome::Absent => Some(String::new()),
+        PropertyOutcome::Known(_) | PropertyOutcome::Unknown => None,
+    }
+}
+
+/// Stamps the menu path on an unidentified menu item by climbing live. The
+/// single-element live read uses this; the tree walk supplies the same path
+/// from the ancestors it already read (`walk::menu_trail`) and only falls
+/// back here for a node whose parent it never visited.
+pub(crate) fn scope_menu_item_live(
+    element: &UIAElement,
+    properties: &mut ElementProperties,
+    deadline: Option<Deadline>,
+) {
+    if !menu_path_identity_enabled() || !properties.is_unidentified_menu_item() {
+        return;
+    }
+    let path = path_name(properties)
+        .and_then(|own| live_menu_path(element, &own, deadline))
+        .map(|(path, _)| path);
+    properties.set_menu_path(match path {
+        Some(path) => PropertyOutcome::Known(PropertyValue::Text(path)),
+        None => PropertyOutcome::Unknown,
+    });
+}
+
+/// The reads a menu path needs, so the deadline discipline is tested with
+/// counted fakes. Each read is one cross-process call; `None` is a failure.
+pub(crate) struct MenuReads<'a, N> {
+    pub(crate) parent: &'a dyn Fn(&N) -> Option<N>,
+    pub(crate) is_menu_item: &'a dyn Fn(&N) -> Option<bool>,
+    pub(crate) name: &'a dyn Fn(&N) -> Option<String>,
+    pub(crate) expired: &'a dyn Fn() -> bool,
+}
+
+impl<N> MenuReads<'_, N> {
+    fn read<T>(&self, call: impl FnOnce() -> Option<T>) -> Option<T> {
+        if (self.expired)() {
+            return None;
+        }
+        let value = call()?;
+        (!(self.expired)()).then_some(value)
+    }
+}
+
+/// A node's menu-path contribution: `Some(None)` for a read non-menu type,
+/// `Some(Some(name))` for a menu item, `None` when a read failed or the
+/// budget ran out before or after any read. No read starts after expiry.
+pub(crate) fn read_menu_node<N>(node: &N, reads: &MenuReads<'_, N>) -> Option<Option<String>> {
+    if !reads.read(|| (reads.is_menu_item)(node))? {
+        return Some(None);
+    }
+    reads.read(|| (reads.name)(node)).map(Some)
+}
+
+/// Climbs while the parent is a MenuItem, collecting names; the first parent
+/// of a read, other type ends the path. Returns the path and how many names
+/// it holds. `None` when any read fails, the budget runs out before or after
+/// a read, or the path would hold more than `MAX_MENU_DEPTH` names.
+pub(crate) fn climb_menu_path<N>(
+    start: N,
+    own: &str,
+    reads: &MenuReads<'_, N>,
+) -> Option<(String, usize)> {
+    let mut innermost_first = vec![own.to_owned()];
+    let mut current = start;
+    loop {
+        let parent = reads.read(|| (reads.parent)(&current))?;
+        if !reads.read(|| (reads.is_menu_item)(&parent))? {
+            let names = innermost_first.len();
+            return Some((join_path(innermost_first), names));
+        }
+        if innermost_first.len() == MAX_MENU_DEPTH {
+            return None;
+        }
+        innermost_first.push(reads.read(|| (reads.name)(&parent))?);
+        current = parent;
+    }
+}
+
+/// The live climb over the raw view; nothing is prepared after expiry.
+pub(crate) fn live_menu_path(
+    element: &UIAElement,
+    own: &str,
+    deadline: Option<Deadline>,
+) -> Option<(String, usize)> {
+    let expired = || deadline.is_some_and(|deadline| deadline.is_expired());
+    if expired() {
+        return None;
+    }
+    let client = crate::tree::automation::automation_client().ok()?;
+    let walker = client.get_raw_view_walker().ok()?;
+    let reads = MenuReads {
+        parent: &|node: &uiautomation::UIElement| walker.get_parent(node).ok(),
+        is_menu_item: &is_menu_item,
+        name: &|node: &uiautomation::UIElement| node.get_name().ok(),
+        expired: &expired,
+    };
+    climb_menu_path(element.0.clone(), own, &reads)
+}
+
+/// One `ControlType` read; `None` when it failed.
+pub(crate) fn is_menu_item(node: &uiautomation::UIElement) -> Option<bool> {
+    node.get_control_type()
+        .ok()
+        .map(|kind| kind == ControlType::MenuItem)
+}
+
+/// `prefix/name` with the name escaped; `prefix` is an already-escaped path.
+pub(crate) fn extend(prefix: Option<&str>, name: &str) -> String {
+    match prefix {
+        Some(prefix) => format!("{prefix}/{}", escape_id(name)),
+        None => escape_id(name),
+    }
+}
+
+/// Outermost menu first, own name last.
+pub(crate) fn join_path(mut innermost_first: Vec<String>) -> String {
+    innermost_first.reverse();
+    innermost_first
+        .iter()
+        .fold(None, |path: Option<String>, name| {
+            Some(extend(path.as_deref(), name))
+        })
+        .unwrap_or_default()
+}
diff --git a/crates/windows/src/tree/properties/menu_path_tests.rs b/crates/windows/src/tree/properties/menu_path_tests.rs
new file mode 100644
index 00000000..c20f2a26
--- /dev/null
+++ b/crates/windows/src/tree/properties/menu_path_tests.rs
@@ -0,0 +1,210 @@
+use super::*;
+
+fn menu_item(automation_id: PropertyOutcome) -> ElementProperties {
+    ElementProperties::from_reads(vec![
+        (
+            TreeProperty::ControlType,
+            PropertyOutcome::Known(PropertyValue::Number(50011)),
+        ),
+        (TreeProperty::AutomationId, automation_id),
+    ])
+}
+
+fn text(value: &str) -> PropertyOutcome {
+    PropertyOutcome::Known(PropertyValue::Text(value.into()))
+}
+
+/// VaderAI patch: a menu item without an AutomationId is identified by its
+/// menu path under its own kind, so same-named items in different menus are
+/// not twins; a failed path read makes the identifier unknown, never absent.
+#[test]
+fn an_unidentified_menu_item_is_identified_by_its_menu_path() {
+    for blank in [text(" "), PropertyOutcome::Absent] {
+        let mut item = menu_item(blank);
+        assert!(item.is_unidentified_menu_item());
+        item.set_menu_path(text("Admin/Query"));
+        let identifier = item.identifier_evidence().preferred_identifier().cloned();
+        assert_eq!(
+            identifier.map(|identifier| (identifier.kind, identifier.value)),
+            Some((IdentifierKind::MenuPath, "Admin/Query".into()))
+        );
+    }
+    let mut other = menu_item(PropertyOutcome::Absent);
+    other.set_menu_path(text("Billing/Query"));
+    let mut same_name = menu_item(PropertyOutcome::Absent);
+    same_name.set_menu_path(text("Admin/Query"));
+    assert_ne!(
+        other.identifier_evidence().identifiers(),
+        same_name.identifier_evidence().identifiers()
+    );
+}
+
+#[test]
+fn a_failed_menu_path_read_is_unknown_and_an_unread_one_is_absent() {
+    for failed in [PropertyOutcome::Unknown, PropertyOutcome::Absent] {
+        let mut item = menu_item(PropertyOutcome::Absent);
+        item.set_menu_path(failed);
+        let evidence = item.identifier_evidence();
+        assert!(!evidence.is_complete());
+        assert!(evidence.identifiers().is_empty());
+    }
+    let unread = menu_item(PropertyOutcome::Absent).identifier_evidence();
+    assert!(unread.is_complete() && unread.identifiers().is_empty());
+}
+
+#[test]
+fn a_menu_item_with_its_own_id_or_an_unread_id_is_left_alone() {
+    assert!(!menu_item(text("Item 5")).is_unidentified_menu_item());
+    assert!(!menu_item(PropertyOutcome::Unknown).is_unidentified_menu_item());
+    let mut identified = menu_item(text("Item 5"));
+    identified.set_menu_path(text("Admin/Query"));
+    assert_eq!(
+        identified.identifier_evidence().preferred_value(),
+        Some("Item 5")
+    );
+    let button = ElementProperties::from_reads(vec![(
+        TreeProperty::ControlType,
+        PropertyOutcome::Known(PropertyValue::Number(50000)),
+    )]);
+    assert!(!button.is_unidentified_menu_item());
+}
+
+#[cfg(target_os = "windows")]
+#[test]
+fn the_path_runs_outermost_first_and_escapes_its_separators() {
+    use crate::tree::properties::identity_scope::join_path;
+
+    assert_eq!(
+        join_path(vec!["Query".into(), "Sub".into(), "Admin".into()]),
+        "Admin/Sub/Query"
+    );
+    assert_ne!(
+        join_path(vec!["c".into(), "a/b".into()]),
+        join_path(vec!["b/c".into(), "a".into()])
+    );
+    assert_eq!(join_path(vec![r"x\".into(), "p".into()]), r"p/x\\");
+    assert_eq!(join_path(vec!["Top".into()]), "Top");
+}
+
+#[cfg(target_os = "windows")]
+mod deadline {
+    use crate::tree::properties::identity_scope::{
+        MAX_MENU_DEPTH, MenuReads, climb_menu_path, read_menu_node,
+    };
+    use std::cell::Cell;
+
+    /// Nodes `0..=len`: each is the parent of the one before, and `len` is a
+    /// non-menu root. Every read counts one call and may spend the budget.
+    struct Chain {
+        len: usize,
+        calls: Cell<usize>,
+        expire_after: Cell<Option<usize>>,
+    }
+
+    impl Chain {
+        fn new(len: usize, expire_after: Option<usize>) -> Self {
+            Self {
+                len,
+                calls: Cell::new(0),
+                expire_after: Cell::new(expire_after),
+            }
+        }
+
+        fn call(&self) {
+            self.calls.set(self.calls.get() + 1);
+        }
+
+        fn expired(&self) -> bool {
+            self.expire_after
+                .get()
+                .is_some_and(|after| self.calls.get() >= after)
+        }
+    }
+
+    fn climb(chain: &Chain) -> Option<(String, usize)> {
+        let reads = MenuReads {
+            parent: &|node: &usize| {
+                chain.call();
+                Some(node + 1)
+            },
+            is_menu_item: &|node: &usize| {
+                chain.call();
+                Some(*node < chain.len)
+            },
+            name: &|node: &usize| {
+                chain.call();
+                Some(format!("m{node}"))
+            },
+            expired: &|| chain.expired(),
+        };
+        climb_menu_path(0, "own", &reads)
+    }
+
+    #[test]
+    fn a_climb_reads_three_calls_per_menu_level_and_stops_at_the_root() {
+        let chain = Chain::new(3, None);
+        assert_eq!(climb(&chain), Some(("m2/m1/own".into(), 3)));
+        assert_eq!(chain.calls.get(), 2 * 3 + 2);
+    }
+
+    /// codex1 P2: a read that returns after spending the budget starts no
+    /// further read, and an already spent budget starts none at all.
+    #[test]
+    fn no_read_starts_after_a_read_spends_the_budget() {
+        for spent_at in 1..=8 {
+            let chain = Chain::new(3, Some(spent_at));
+            assert_eq!(climb(&chain), None, "spent after call {spent_at}");
+            assert_eq!(chain.calls.get(), spent_at, "spent after call {spent_at}");
+        }
+        let already = Chain::new(3, Some(0));
+        assert_eq!(climb(&already), None);
+        assert_eq!(already.calls.get(), 0);
+    }
+
+    #[test]
+    fn a_chain_past_the_depth_limit_stops_before_reading_another_name() {
+        let chain = Chain::new(MAX_MENU_DEPTH + 2, None);
+        assert_eq!(climb(&chain), None);
+        assert_eq!(chain.calls.get(), (MAX_MENU_DEPTH - 1) * 3 + 2);
+    }
+
+    #[test]
+    fn a_node_read_spends_no_name_call_after_its_type_spends_the_budget() {
+        let chain = Chain::new(3, Some(1));
+        let reads = MenuReads {
+            parent: &|_: &usize| None,
+            is_menu_item: &|_: &usize| {
+                chain.call();
+                Some(true)
+            },
+            name: &|_: &usize| {
+                chain.call();
+                Some("x".into())
+            },
+            expired: &|| chain.expired(),
+        };
+        assert_eq!(read_menu_node(&0, &reads), None);
+        assert_eq!(chain.calls.get(), 1);
+        chain.expire_after.set(None);
+        assert_eq!(read_menu_node(&0, &reads), Some(Some("x".into())));
+        assert_eq!(chain.calls.get(), 3);
+    }
+}
