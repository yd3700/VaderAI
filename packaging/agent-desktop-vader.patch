@@ -0,0 +1,203 @@
+//! VaderAI patch: menu paths for the tree walk, from ancestors the walk has
+//! already read.
+//!
+//! A menu item without an AutomationId is identified by its menu path
+//! (`properties::identity_scope`). Climbing live for every item costs several
+//! cross-process calls each into a slow provider: a 571-item WinForms menu
+//! took 18.4s to snapshot instead of 9.1s, and its items report empty runtime
+//! ids, so nothing keys a cache of climbs. The walk already reads every
+//! ancestor on its way down, so the trail remembers, per element the source
+//! hands out, what its parent contributes to a path.
+//!
+//! The path is a name-based identity, not a provider id: renaming a menu
+//! makes its items stale, and an item that takes over another's whole path
+//! takes over its identity. Two items with one path are twins and refuse.
+//!
+//! Elements are keyed by COM pointer, and every keyed element is kept alive
+//! by the trail so an address is never reused for another element while the
+//! trail lives. The same UI element reached through two wrappers is two keys;
+//! that only costs a live read, never a wrong path. An element the trail
+//! never saw climbs live instead of guessing.
+
+use std::collections::HashMap;
+
+use crate::tree::properties::ElementProperties;
+use crate::tree::properties::identity_scope::{MAX_MENU_DEPTH, extend, path_name};
+use crate::tree::properties::property_ids::TreeProperty;
+use crate::tree::properties::{PropertyOutcome, PropertyValue};
+
+/// What a node contributes to the menu paths of its children.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) enum Above {
+    /// A node of a read, non-menu control type: a child's path starts at it.
+    NotMenu,
+    /// A menu item with this escaped path of this many names.
+    Path(String, usize),
+    /// A node whose type, name or own path could not be read: nothing under
+    /// it gets a path.
+    Failed,
+}
+
+/// A node's control type as a menu path reads it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum NodeKind {
+    MenuItem,
+    Other,
+    Unread,
+}
+
+impl NodeKind {
+    pub(crate) fn of(properties: &ElementProperties) -> Self {
+        match properties.get(TreeProperty::ControlType) {
+            PropertyOutcome::Known(PropertyValue::Number(50011)) => Self::MenuItem,
+            PropertyOutcome::Known(PropertyValue::Number(_)) => Self::Other,
+            PropertyOutcome::Known(_) | PropertyOutcome::Absent | PropertyOutcome::Unknown => {
+                Self::Unread
+            }
+        }
+    }
+}
+
+/// The path of a menu item named `name` under `parent`; `None` is unknown,
+/// including a path longer than the live climb would accept.
+pub(crate) fn path_under(parent: &Above, name: Option<&str>) -> Option<(String, usize)> {
+    let (path, names) = match (parent, name) {
+        (Above::NotMenu, Some(name)) => (extend(None, name), 1),
+        (Above::Path(prefix, names), Some(name)) => (extend(Some(prefix), name), names + 1),
+        (Above::Failed, _) | (_, None) => return None,
+    };
+    (names <= MAX_MENU_DEPTH).then_some((path, names))
+}
+
+/// What a node passes down, given what its own parent passed to it.
+pub(crate) fn passes_down(parent: &Above, kind: NodeKind, name: Option<&str>) -> Above {
+    match kind {
+        NodeKind::Other => Above::NotMenu,
+        NodeKind::Unread => Above::Failed,
+        NodeKind::MenuItem => {
+            path_under(parent, name).map_or(Above::Failed, |(path, names)| Above::Path(path, names))
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+pub(crate) use imp::MenuTrail;
+
+#[cfg(target_os = "windows")]
+mod imp {
+    use super::{Above, ElementProperties, HashMap, NodeKind, PropertyOutcome, PropertyValue};
+    use super::{passes_down, path_name, path_under};
+    use crate::tree::element::UIAElement;
+    use crate::tree::properties::identity_scope::{
+        MenuReads, is_menu_item, live_menu_path, menu_path_identity_enabled, read_menu_node,
+        scope_menu_item_live,
+    };
+    use agent_desktop_core::Deadline;
+    use windows::Win32::UI::Accessibility::IUIAutomationElement;
+    use windows::core::Interface;
+
+    #[derive(Default)]
+    pub(crate) struct MenuTrail {
+        /// Every element the source handed out or descended from, kept alive.
+        nodes: HashMap<usize, uiautomation::UIElement>,
+        /// The element each handed-out element was last reached under.
+        parent_of: HashMap<usize, usize>,
+        /// What each node passes down to its children, once known.
+        own: HashMap<usize, Above>,
+        /// The observation's deadline; every live read checks it first.
+        deadline: Option<Deadline>,
+    }
+
+    fn key(node: &uiautomation::UIElement) -> usize {
+        let element: &IUIAutomationElement = node.as_ref();
+        element.as_raw() as usize
+    }
+
+    impl MenuTrail {
+        pub(crate) fn bind(&mut self, deadline: Deadline) {
+            self.deadline = Some(deadline);
+        }
+
+        fn keep(&mut self, node: &UIAElement) -> usize {
+            let key = key(&node.0);
+            self.nodes.entry(key).or_insert_with(|| node.0.clone());
+            key
+        }
+
+        pub(crate) fn note_first_child(&mut self, parent: &UIAElement, child: &UIAElement) {
+            let (parent, child) = (self.keep(parent), self.keep(child));
+            self.parent_of.insert(child, parent);
+        }
+
+        pub(crate) fn note_next_sibling(&mut self, node: &UIAElement, sibling: &UIAElement) {
+            if let Some(parent) = self.parent_of.get(&key(&node.0)).copied() {
+                let sibling = self.keep(sibling);
+                self.parent_of.insert(sibling, parent);
+            }
+        }
+
+        /// Stamps the node's menu path if it needs one, and records what the
+        /// node passes down. A node the source did not reach by navigation
+        /// has no known parent and climbs live.
+        pub(crate) fn scope(&mut self, node: &UIAElement, properties: &mut ElementProperties) {
+            if !menu_path_identity_enabled() {
+                return;
+            }
+            let node_key = self.keep(node);
+            let Some(parent) = self.parent_of.get(&node_key).copied() else {
+                scope_menu_item_live(node, properties, self.deadline);
+                return;
+            };
+            let parent = self.passed_down_by(parent);
+            let name = path_name(properties);
+            if properties.is_unidentified_menu_item() {
+                properties.set_menu_path(match path_under(&parent, name.as_deref()) {
+                    Some((path, _)) => PropertyOutcome::Known(PropertyValue::Text(path)),
+                    None => PropertyOutcome::Unknown,
+                });
+            }
+            let down = passes_down(&parent, NodeKind::of(properties), name.as_deref());
+            self.own.insert(node_key, down);
+        }
+
+        /// What a kept node passes down. A node whose evidence the walk never
+        /// read (a path descent steps over it) is read live once, and the
+        /// answer serves all its children.
+        fn passed_down_by(&mut self, node_key: usize) -> Above {
+            if let Some(known) = self.own.get(&node_key) {
+                return known.clone();
+            }
+            let state = self.read_passed_down(node_key).unwrap_or(Above::Failed);
+            self.own.insert(node_key, state.clone());
+            state
+        }
+
+        fn read_passed_down(&mut self, node_key: usize) -> Option<Above> {
+            let node = self.nodes.get(&node_key)?.clone();
+            let deadline = self.deadline;
+            let expired = || deadline.is_some_and(|deadline| deadline.is_expired());
+            let reads = MenuReads {
+                parent: &|_: &uiautomation::UIElement| None,
+                is_menu_item: &is_menu_item,
+                name: &|node: &uiautomation::UIElement| node.get_name().ok(),
+                expired: &expired,
+            };
+            let Some(name) = read_menu_node(&node, &reads)? else {
+                return Some(Above::NotMenu);
+            };
+            Some(match self.parent_of.get(&node_key).copied() {
+                Some(parent) => passes_down(
+                    &self.passed_down_by(parent),
+                    NodeKind::MenuItem,
+                    Some(&name),
+                ),
+                None => live_menu_path(&UIAElement::from(node), &name, self.deadline)
+                    .map_or(Above::Failed, |(path, names)| Above::Path(path, names)),
+            })
+        }
+    }
+}
+
