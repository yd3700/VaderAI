@@ -0,0 +1,68 @@
+use super::{Above, NodeKind, passes_down, path_under};
+use crate::tree::properties::identity_scope::MAX_MENU_DEPTH;
+
+fn menu(parent: &Above, name: &str) -> Above {
+    passes_down(parent, NodeKind::MenuItem, Some(name))
+}
+
+#[test]
+fn a_path_grows_one_escaped_name_per_menu_level() {
+    let top = menu(&Above::NotMenu, "Admin");
+    assert_eq!(top, Above::Path("Admin".into(), 1));
+    let sub = menu(&top, "a/b");
+    assert_eq!(sub, Above::Path(r"Admin/a\/b".into(), 2));
+    assert_eq!(
+        path_under(&sub, Some("Query")),
+        Some((r"Admin/a\/b/Query".into(), 3))
+    );
+    assert_eq!(
+        path_under(&Above::NotMenu, Some("")),
+        Some((String::new(), 1))
+    );
+}
+
+#[test]
+fn only_a_read_non_menu_type_restarts_the_path_below_it() {
+    let top = menu(&Above::NotMenu, "Admin");
+    assert_eq!(
+        passes_down(&top, NodeKind::Other, Some("Pane")),
+        Above::NotMenu
+    );
+}
+
+/// codex1 P1: a parent whose control type could not be read must not pass
+/// `NotMenu` down, or `Admin/Query` would shorten to a whole `Query` that can
+/// equal a different top-level `Query`.
+#[test]
+fn an_unread_parent_type_fails_everything_under_it_instead_of_shortening() {
+    let top = menu(&Above::NotMenu, "Admin");
+    let unread = passes_down(&top, NodeKind::Unread, Some("Sub"));
+    assert_eq!(unread, Above::Failed);
+    assert_eq!(path_under(&unread, Some("Query")), None);
+    assert_ne!(
+        path_under(&unread, Some("Query")),
+        path_under(&Above::NotMenu, Some("Query"))
+    );
+    assert_eq!(menu(&unread, "Deeper"), Above::Failed);
+}
+
+#[test]
+fn an_unread_name_fails_the_item_and_everything_under_it() {
+    let top = passes_down(&Above::NotMenu, NodeKind::MenuItem, None);
+    assert_eq!(top, Above::Failed);
+    assert_eq!(path_under(&top, Some("Query")), None);
+    assert_eq!(menu(&top, "Sub"), Above::Failed);
+    assert_eq!(path_under(&Above::NotMenu, None), None);
+}
+
+/// The walk accepts exactly the depths the live climb accepts.
+#[test]
+fn a_path_longer_than_the_live_climb_accepts_is_unknown() {
+    let mut level = Above::NotMenu;
+    for index in 0..MAX_MENU_DEPTH {
+        level = menu(&level, &format!("m{index}"));
+        assert!(matches!(level, Above::Path(_, names) if names == index + 1));
+    }
+    assert_eq!(path_under(&level, Some("too deep")), None);
+    assert_eq!(menu(&level, "too deep"), Above::Failed);
+}
