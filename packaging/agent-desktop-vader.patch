@@ -0,0 +1,203 @@
+use super::*;
+use std::sync::atomic::{AtomicU32, Ordering};
+
+struct MenuAdapter {
+    live: LiveElement,
+    vouches: bool,
+    asked: AtomicU32,
+}
+
+impl ObservationOps for MenuAdapter {
+    fn get_live_element(
+        &self,
+        _handle: &NativeHandle,
+        _deadline: crate::Deadline,
+    ) -> Result<LiveElement, AdapterError> {
+        Ok(self.live.clone())
+    }
+
+    fn is_closed_menu_command(
+        &self,
+        _handle: &NativeHandle,
+        _deadline: crate::Deadline,
+    ) -> Result<bool, AdapterError> {
+        self.asked.fetch_add(1, Ordering::SeqCst);
+        Ok(self.vouches)
+    }
+
+    fn hit_test(
+        &self,
+        _handle: &NativeHandle,
+        _point: crate::Point,
+        _deadline: crate::Deadline,
+    ) -> Result<crate::adapter::hit_test::HitTestResult, AdapterError> {
+        Ok(crate::adapter::hit_test::HitTestResult::ReachesTarget)
+    }
+}
+
+impl ActionOps for MenuAdapter {}
+impl InputOps for MenuAdapter {}
+impl SystemOps for MenuAdapter {}
+
+/// An offscreen-reporting element with real bounds, the WinForms menu shape.
+fn offscreen(role: &str, actions: &[&str], vouches: bool) -> (RefEntry, MenuAdapter) {
+    let mut target = entry();
+    target.identity.role = role.into();
+    let bounds = Rect {
+        x: 10.0,
+        y: 10.0,
+        width: 80.0,
+        height: 20.0,
+    };
+    target.geometry.bounds = Some(bounds);
+    target.geometry.bounds_hash = bounds.bounds_hash();
+    let live = LiveElement {
+        identity: crate::adapter::live_identity("OK"),
+        state: ElementState {
+            role: role.into(),
+            states: vec![crate::tree::state::OFFSCREEN.into()],
+            value: None,
+            enabled: Some(true),
+            hidden: None,
+            offscreen: Some(true),
+        },
+        states_complete: true,
+        bounds: Some(bounds),
+        available_actions: actions.iter().map(|action| (*action).into()).collect(),
+    };
+    let adapter = MenuAdapter {
+        live,
+        vouches,
+        asked: AtomicU32::new(0),
+    };
+    (target, adapter)
+}
+
+fn run(
+    target: &RefEntry,
+    adapter: &MenuAdapter,
+    request: ActionRequest,
+) -> Result<report::ActionabilityReport, AdapterError> {
+    check_live(target, &NativeHandle::null(), adapter, &request)
+}
+
+fn refused_on_visible(result: Result<report::ActionabilityReport, AdapterError>) {
+    let error = result.expect_err("the offscreen report must still refuse");
+    assert!(error.message.contains("visible"), "{}", error.message);
+}
+
+#[test]
+fn a_vouched_closed_menu_command_is_clicked_semantically_despite_offscreen() {
+    let (target, adapter) = offscreen("menuitem", &[capability::CLICK], true);
+    let report = run(&target, &adapter, ActionRequest::headless(Action::Click)).unwrap();
+
+    assert!(report.actionable);
+    assert_eq!(report.pointer_delivery, PointerDelivery::Semantic);
+    assert_eq!(report.verified_point, None, "no pointer is aimed");
+    assert_eq!(adapter.asked.load(Ordering::SeqCst), 1);
+}
+
+#[test]
+fn an_unvouched_offscreen_menu_item_is_still_refused() {
+    let (target, adapter) = offscreen("menuitem", &[capability::CLICK], false);
+
+    refused_on_visible(run(
+        &target,
+        &adapter,
+        ActionRequest::headless(Action::Click),
+    ));
+    assert_eq!(adapter.asked.load(Ordering::SeqCst), 1);
+}
+
+#[test]
+fn the_exception_is_never_asked_outside_a_headless_semantic_menu_click() {
+    let cases: [(&str, &[&str], ActionRequest); 5] = [
+        (
+            "button",
+            &[capability::CLICK],
+            ActionRequest::headless(Action::Click),
+        ),
+        ("menuitem", &[], ActionRequest::headless(Action::Click)),
+        (
+            "menuitem",
+            &[capability::CLICK],
+            ActionRequest::headed(Action::Click),
+        ),
+        (
+            "menuitem",
+            &[capability::CLICK],
+            ActionRequest::headless(Action::Hover),
+        ),
+        (
+            "menuitem",
+            &[capability::EXPAND],
+            ActionRequest::headless(Action::Expand),
+        ),
+    ];
+    for (role, actions, request) in cases {
+        let (target, adapter) = offscreen(role, actions, true);
+        let label = format!("{role} {actions:?} {:?}", request.action);
+
+        assert!(run(&target, &adapter, request).is_err(), "{label}");
+        assert_eq!(adapter.asked.load(Ordering::SeqCst), 0, "{label}");
+    }
+}
+
+#[test]
+fn hidden_or_incomplete_state_keeps_the_gate_closed_without_asking() {
+    let (target, mut adapter) = offscreen("menuitem", &[capability::CLICK], true);
+    adapter.live.state.hidden = Some(true);
+    refused_on_visible(run(
+        &target,
+        &adapter,
+        ActionRequest::headless(Action::Click),
+    ));
+
+    let (target, mut incomplete) = offscreen("menuitem", &[capability::CLICK], true);
+    incomplete.live.states_complete = false;
+    assert!(run(&target, &incomplete, ActionRequest::headless(Action::Click)).is_err());
+
+    assert_eq!(adapter.asked.load(Ordering::SeqCst), 0);
+    assert_eq!(incomplete.asked.load(Ordering::SeqCst), 0);
+}
+
+#[test]
+fn a_disabled_closed_menu_command_is_refused_by_the_enabled_gate() {
+    let (target, mut adapter) = offscreen("menuitem", &[capability::CLICK], true);
+    adapter.live.state.enabled = Some(false);
+    adapter
+        .live
+        .state
+        .states
+        .push(crate::tree::state::DISABLED.into());
+
+    let error = run(&target, &adapter, ActionRequest::headless(Action::Click))
+        .expect_err("a disabled command is not sent");
+    assert!(error.message.contains("enabled"), "{}", error.message);
+}
+
+/// The exception replaces any visibility `Fail`, not only the offscreen one:
+/// a command has no position, so a vouched item with zero-sized bounds is
+/// sent the same way. `Unknown` visibility is never replaced.
+#[test]
+fn a_vouched_command_with_zero_sized_bounds_is_also_sent() {
+    let (target, mut adapter) = offscreen("menuitem", &[capability::CLICK], true);
+    let empty = Rect {
+        x: 0.0,
+        y: 0.0,
+        width: 0.0,
+        height: 0.0,
+    };
+    adapter.live.bounds = Some(empty);
+    adapter.live.state.offscreen = Some(false);
+    adapter.live.state.states.clear();
+    let mut target = target;
+    target.geometry.bounds = Some(empty);
+    target.geometry.bounds_hash = empty.bounds_hash();
+
+    assert!(
+        run(&target, &adapter, ActionRequest::headless(Action::Click))
+            .unwrap()
+            .actionable
+    );
+}
