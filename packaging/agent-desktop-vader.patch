@@ -0,0 +1,71 @@
+use super::*;
+
+fn edit_evidence(identifiers: IdentifierEvidence) -> LocatorEvidence {
+    LocatorEvidence {
+        identifiers,
+        ..evidence("textfield", "", Vec::new(), 0)
+    }
+}
+
+fn scoped(value: &str) -> IdentifierEvidence {
+    IdentifierEvidence::typed(
+        [identifier(IdentifierKind::ParentAutomationId, value)],
+        Some(0),
+        true,
+    )
+}
+
+fn twin_edits(first: IdentifierEvidence, second: IdentifierEvidence) -> ObservedTree {
+    let leaf =
+        |identifiers| ObservedSubtree::new(edit_evidence(identifiers), Vec::new(), true, None);
+    ObservedTree::from_roots(
+        vec![ObservedSubtree::new(
+            evidence("window", "Fixture", Vec::new(), 0),
+            vec![leaf(first), leaf(second)],
+            true,
+            None,
+        )],
+        ObservationSource::Window {
+            window: fixture_window(),
+            surface: crate::SnapshotSurface::Window,
+            renderer_accessibility_forced: false,
+        },
+        LocatorStats::default(),
+        true,
+    )
+    .expect("the fixture observes")
+}
+
+fn edit_node(native_id: Option<&str>) -> AccessibilityNode {
+    let mut node = named("textfield", "");
+    node.identity.native_id =
+        native_id.map(|value| identifier(IdentifierKind::ParentAutomationId, value));
+    node
+}
+
+/// VaderAI patch (codex1 회신 2 P1-1): two Edits share role, name and real
+/// parent `P`. Whichever one failed its parent read carries unknown identifier
+/// evidence, so neither the failed one nor its twin is proven unique - the
+/// failure moving between the two never proves the wrong one.
+#[test]
+fn a_twin_whose_parent_read_failed_proves_neither_edit_unique() {
+    for failed_first in [true, false] {
+        let (first, second) = if failed_first {
+            (IdentifierEvidence::unknown(), scoped("P/x"))
+        } else {
+            (scoped("P/x"), IdentifierEvidence::unknown())
+        };
+        let ids = if failed_first {
+            [None, Some("P/x")]
+        } else {
+            [Some("P/x"), None]
+        };
+        let root = window(ids.into_iter().map(edit_node).collect());
+        assert_eq!(flags(root, &twin_edits(first, second)), [false, false]);
+    }
+    let root = window(vec![edit_node(Some("P/x")), edit_node(Some("Q/x"))]);
+    assert_eq!(
+        flags(root, &twin_edits(scoped("P/x"), scoped("Q/x"))),
+        [true, true]
+    );
+}
