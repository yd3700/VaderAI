+
+fn live_edits(
+    identifiers: [crate::locator::live_locator::IdentifierEvidence; 2],
+) -> crate::locator::live_locator::ObservedTree {
+    use crate::locator::live_locator::{
+        LocatorEvidence, LocatorField, LocatorRefEvidence, LocatorStats, ObservationSource,
+        ObservedSubtree, ObservedTree,
+    };
+    let evidence = |role: &str, identifiers| LocatorEvidence {
+        role: LocatorField::Known(role.into()),
+        name: LocatorField::Known(String::new()),
+        description: LocatorField::Absent,
+        value: LocatorField::Absent,
+        identifiers,
+        states: LocatorField::Known(Vec::new()),
+        ref_evidence: LocatorRefEvidence {
+            window_bounds: LocatorField::Absent,
+            bounds: LocatorField::Absent,
+            available_actions: LocatorField::Known(Vec::new()),
+            descriptors: Default::default(),
+        },
+    };
+    let leaves = identifiers
+        .into_iter()
+        .map(|ids| ObservedSubtree::new(evidence("textfield", ids), Vec::new(), true, None))
+        .collect();
+    let root = evidence(
+        "window",
+        crate::locator::live_locator::IdentifierEvidence::absent(),
+    );
+    ObservedTree::from_roots(
+        vec![ObservedSubtree::new(root, leaves, true, None)],
+        ObservationSource::Window {
+            window: window(),
+            surface: crate::SnapshotSurface::Window,
+            renderer_accessibility_forced: false,
+        },
+        LocatorStats::default(),
+        true,
+    )
+    .expect("the fixture observes")
+}
+
+/// VaderAI patch (codex1 회신 2 P1-1): a saved Edit ref recorded as `P/x` never
+/// resolves while a live Edit could not read its parent - whether the failed
+/// one is the target or its twin - and a plain `x` never stands in for `P/x`.
+#[test]
+fn a_parent_scoped_edit_refuses_while_any_twin_parent_is_unknown() {
+    use crate::locator::live_locator::IdentifierEvidence;
+    use crate::{ElementIdentifier, IdentifierKind};
+    let id = |kind, value: &str| ElementIdentifier {
+        kind,
+        value: value.into(),
+    };
+    let known = |kind, value| IdentifierEvidence::typed([id(kind, value)], Some(0), true);
+    let scoped = |value| known(IdentifierKind::ParentAutomationId, value);
+    let mut saved = crate::adapter::minimal_ref_entry("textfield", Some(""));
+    saved.identity.native_id = Some(id(IdentifierKind::ParentAutomationId, "P/x"));
+    let refused = |live| super::unique_live_match(&saved, &live_edits(live)).is_err();
+
+    assert!(refused([IdentifierEvidence::unknown(), scoped("P/x")]));
+    assert!(refused([scoped("P/x"), IdentifierEvidence::unknown()]));
+    assert!(refused([
+        known(IdentifierKind::AutomationId, "x"),
+        scoped("Q/x")
+    ]));
+    assert_eq!(
+        super::unique_live_match(&saved, &live_edits([scoped("Q/x"), scoped("P/x")])).ok(),
+        Some(2)
+    );
+}
